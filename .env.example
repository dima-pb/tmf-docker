# Copy to .env and fill in. .env is not tracked by git (passwords, tokens).
# Values are inserted into the templates in config/ wherever ${TMF_...} appears.
#
# Docker compose replaces $name in values with variables. Values containing '$' (TM color codes,
# passwords) must be put in single quotes to be taken literally:  TMF_SERVER_NAME='$af0Hunt'

# ---- Where the software comes from (not part of this repo) ----
# TrackMania dedicated server 2011-02-21 (unzipped download from Nadeo)
TMSERVER_DIR=../TrackmaniaServer_2011-02-21
# XAseco 1.16
XASECO_DIR=../xaseco
# pyseco checkout
PYSECO_DIR=../pyseco
# Apply the tie-break fix (equal times: first driver ranks first) to the server binary: 1 = yes, 0 = no
TMF_TIEBREAK_PATCH=1

# ---- Your user on the host: containers write data/ as this user (see: id -u / id -g) ----
UID=1000
GID=1000
# Time zone for logs and XAseco
TZ=Europe/Berlin

# ---- Dedicated server ----
TMF_SERVER_NAME=My TMF Server
TMF_SERVER_COMMENT=
# Server account from https://players.trackmaniaforever.com (dedicated server login).
# Alternatively the login/password of a separate player account (create one in the game) works too,
# that account can't play online while the server uses it.
# Leave login empty for a LAN-only server (no account needed, no Dedimania).
TMF_SERVER_LOGIN=
TMF_SERVER_PASSWORD=
TMF_SERVER_VALIDATION_KEY=
# 3-letter IOC country code, used by Dedimania (e.g. GER, AUT, SUI)
TMF_SERVER_NATION=GER
# Public address players connect to (needed for internet servers behind NAT / in docker)
TMF_PUBLIC_IP=
# Ports published on the host (the same ports are used inside the container)
TMF_PORT=2350
TMF_P2P_PORT=3450
# Match settings file inside data/tmserver/tracks (created from config/tmserver/matchsettings.txt on first start)
TMF_MATCHSETTINGS=MatchSettings/active.txt

# XML-RPC passwords of the server (only reachable inside the docker network)
TMF_SUPERADMIN_PASSWORD=change-me
TMF_ADMIN_PASSWORD=change-me-too
TMF_USER_PASSWORD=User

# ---- XAseco ----
# Your TMF player login, gets MasterAdmin rights in XAseco (required, XAseco does not start without it)
TMF_MASTERADMIN_LOGIN=

# ---- Database (MariaDB, only reachable inside the docker network) ----
TMF_MYSQL_PASSWORD=change-me-db
TMF_MYSQL_ROOT_PASSWORD=change-me-root

# ---- pyseco / Discord ----
TMF_DISCORD_TOKEN=
TMF_DISCORD_CHANNEL_ID=
TMF_DISCORD_INVITE=
# Discord user ids with admin commands, comma separated
TMF_DISCORD_ADMINS=
